aws_region        = "us-east-1"
github_repository = "GinaUnderwood/detective-reader"
github_environment = "production"

# Set this false if token.actions.githubusercontent.com already exists in the
# AWS account, then supply its ARN below.
create_github_oidc_provider       = true
existing_github_oidc_provider_arn = ""

# Leave blank to generate detective-reader-tfstate-ACCOUNT_ID-REGION.
state_bucket_name = ""
