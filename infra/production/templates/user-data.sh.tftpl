#!/usr/bin/env bash
set -euo pipefail

dnf install -y awscli curl docker jq util-linux
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

install -d -m 0755 /usr/local/lib/docker/cli-plugins

COMPOSE_VERSION="${compose_version}"
COMPOSE_ARCH="x86_64"
COMPOSE_ASSET="docker-compose-linux-$${COMPOSE_ARCH}"
COMPOSE_BASE_URL="https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}"
COMPOSE_TMP="$(mktemp -d)"
trap 'rm -rf "$${COMPOSE_TMP}"' EXIT

curl --fail --silent --show-error --location \
  "$${COMPOSE_BASE_URL}/$${COMPOSE_ASSET}" \
  --output "$${COMPOSE_TMP}/$${COMPOSE_ASSET}"
curl --fail --silent --show-error --location \
  "$${COMPOSE_BASE_URL}/checksums.txt" \
  --output "$${COMPOSE_TMP}/checksums.txt"

grep -E "[[:space:]*]$${COMPOSE_ASSET}$" "$${COMPOSE_TMP}/checksums.txt" \
  >"$${COMPOSE_TMP}/selected-checksum.txt"
(
  cd "$${COMPOSE_TMP}"
  sha256sum --check --strict selected-checksum.txt
)

install -m 0755 \
  "$${COMPOSE_TMP}/$${COMPOSE_ASSET}" \
  /usr/local/lib/docker/cli-plugins/docker-compose
rm -rf "$${COMPOSE_TMP}"
trap - EXIT

docker compose version

install -d -m 0700 /etc/detective-reader
install -d -m 0755 /opt/detective-reader
install -d -m 0755 /usr/local/sbin

printf '%s' '${host_environment_b64}' |
  base64 --decode >/etc/detective-reader/host.env
chmod 0600 /etc/detective-reader/host.env

printf '%s' '${compose_yaml_b64}' |
  base64 --decode >/opt/detective-reader/compose.yaml
chmod 0444 /opt/detective-reader/compose.yaml

printf '%s' '${caddyfile_b64}' |
  base64 --decode >/opt/detective-reader/Caddyfile
chmod 0444 /opt/detective-reader/Caddyfile

printf '%s' '${deploy_script_b64}' |
  base64 --decode >/usr/local/sbin/detective-reader-deploy
chmod 0700 /usr/local/sbin/detective-reader-deploy

printf '%s' '${start_script_b64}' |
  base64 --decode >/usr/local/sbin/detective-reader-start
chmod 0700 /usr/local/sbin/detective-reader-start

printf '%s' '${service_unit_b64}' |
  base64 --decode >/etc/systemd/system/detective-reader.service
chmod 0644 /etc/systemd/system/detective-reader.service

systemctl daemon-reload
systemctl enable --now detective-reader.service
