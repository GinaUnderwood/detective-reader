aws_region        = "us-east-1"
github_repository = "GinaUnderwood/detective-reader"
github_environment = "production"

instance_type   = "t3.micro"
root_volume_size = 20

# A real hostname enables Caddy-managed HTTPS. Leave route53_zone_id blank when
# DNS is hosted somewhere else, then point an A record to the public_ip output.
domain_name    = "reader.example.com"
route53_zone_id = ""

# Optional existing SNS topic for EC2 status-check alarm notifications.
alarm_sns_topic_arn = ""
